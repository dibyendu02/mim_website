# Canonical site URL, used for metadata / Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://mimdigital.in

# Booking calendar (Calendly, Cal.com, HubSpot…). When unset, "Book a
# Strategy Call" leads to the enquiry form at /contact#enquiry instead.
NEXT_PUBLIC_BOOKING_URL=

# Where enquiry form submissions are POSTed as JSON (CRM, Zapier/Make hook,
# email function). Required in production — without it the form shows its
# error state rather than silently dropping leads.
CONTACT_WEBHOOK_URL=
